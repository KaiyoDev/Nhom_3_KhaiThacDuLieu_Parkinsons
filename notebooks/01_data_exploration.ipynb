    "# M03-T2: Kiểm tra chất lượng dữ liệu\n",
    "\n",
    "# 1. Kiểm tra số lượng giá trị thiếu theo từng cột\n",
    "print(\"===== 1. DỮ LIỆU THIẾU (NaN) =====\")\n",
    "missing = df.isna().sum()\n",
    "print(missing)\n",
    "print(\"Tổng số giá trị thiếu:\", missing.sum())\n",
    "\n",
    "# 2. Kiểm tra số dòng trùng lặp\n",
    "print(\"\\n===== 2. DỮ LIỆU TRÙNG LẶP =====\")\n",
    "duplicate_count = df.duplicated().sum()\n",
    "print(\"Số dòng bị trùng:\", duplicate_count)\n",
    "\n",
    "# 3. Thống kê các phân vị để tìm giá trị bất thường\n",
    "print(\"\\n===== 3. THỐNG KÊ PHÂN VỊ 1% VÀ 99% =====\")\n",
    "numeric_features = df.select_dtypes(include=\"number\")\n",
    "\n",
    "display(\n",
    "    numeric_features.describe(\n",
    "        percentiles=[0.01, 0.25, 0.5, 0.75, 0.99]\n",
    "    ).T.round(4)\n",
    ")"
   ]
