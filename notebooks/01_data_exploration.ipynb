   "source": [
    "# M03-T1: Thống kê mô tả các thuộc tính số\n",
    "\n",
    "# Lấy các cột số, loại bỏ status vì đây là nhãn phân lớp\n",
    "numeric_features = df.select_dtypes(include=\"number\").drop(\n",
    "    columns=[\"status\"],\n",
    "    errors=\"ignore\"\n",
    ")\n",
    "\n",
    "# Tính các chỉ số thống kê\n",
    "stats = pd.DataFrame({\n",
    "    \"mean\": numeric_features.mean(),\n",
    "    \"median\": numeric_features.median(),\n",
    "    \"std\": numeric_features.std(),\n",
    "    \"min\": numeric_features.min(),\n",
    "    \"max\": numeric_features.max()\n",
    "})\n",
    "\n",
    "print(\"BẢNG THỐNG KÊ MÔ TẢ:\")\n",
    "display(stats.round(4))"
   ]
  },
